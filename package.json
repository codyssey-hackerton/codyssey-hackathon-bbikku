{
  "name": "pikku",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pikku/mobile",
    "dev:api": "npm run dev --workspace @pikku/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:local": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "export:mobile": "npm run export --workspace @pikku/mobile",
    "dev:db": "node scripts/postgres-local.mjs",
    "verify:model": "node --env-file-if-exists=.env.local --import tsx scripts/verify-model.ts",
    "verify:planning": "node --env-file-if-exists=.env.local --import tsx scripts/verify-live-planning.ts",
    "connect:gmail": "node --env-file-if-exists=.env.local --import tsx scripts/connect-gmail.mjs",
    "test:postgres": "node scripts/test-postgres.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
