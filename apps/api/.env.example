# Copy or export explicitly; the server does not load this file automatically.
# Local development only. Development authentication defaults to loopback; use npm run dev:local -- --lan for an explicit LAN session.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
# Explicit opt-in; provide a private local token of at least 16 non-whitespace characters.
PIKKU_DEV_AUTH=false
PIKKU_DEV_ALLOW_LAN=false
PIKKU_DEV_SESSION_TOKEN=
# Only this project-specific key enables the Responses adapter. No automatic fallback.
PIKKU_OPENAI_API_KEY=
# Empty selects the explicitly volatile memory adapter.
PIKKU_DATABASE_URL=
# Requires PostgreSQL. User review settings still default to disabled.
PIKKU_SCHEDULER_ENABLED=false

# Kakao place/current-route APIs: server-side REST key, never a mobile or JavaScript SDK key.
PIKKU_KAKAO_REST_API_KEY=

# Optional trusted absolute directory for local Gmail/Calendar credentials; empty keeps worktree defaults.
PIKKU_GOOGLE_CREDENTIAL_DIR=

# Preview only: bind the three Google connections to exactly one registered member.
# Requires an explicit private PIKKU_GOOGLE_CREDENTIAL_DIR; never expose credentials to clients.
PIKKU_GOOGLE_CONNECTION_USER_ID=
# Seoul station arrivals, server-side only. Open-Meteo does not require a key.
SEOUL_SUBWAY_API_KEY=
# Default https; explicit http sends the provider key/station over an unencrypted upstream.
# No automatic downgrade. Any other value fails closed.
SEOUL_SUBWAY_TRANSPORT=https
