{
  "expo": {
    "name": "PIKKU",
    "slug": "pikku-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codyssey.pikku.dev"
    },
    "android": {
      "package": "com.codyssey.pikku.dev",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "최근 7일의 걸음 수와 운동 기록을 기기에서 확인하기 위해 건강 데이터 읽기 권한이 필요합니다.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "./plugins/with-health-connect-rationale.cjs",
      "react-native-health-connect",
      [
        "expo-contacts",
        {
          "contactsPermission": "이름으로 연락할 상대를 찾고 선택한 전화번호를 확인하기 위해 연락처 읽기 권한이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치에서 약속 장소까지 이동시간을 계산하기 위해 앱 사용 중 위치 권한이 필요합니다.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ]
    ]
  }
}
