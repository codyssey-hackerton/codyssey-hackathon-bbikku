# Copy to .env.local (gitignored) for npm run dev:local.
# Never put this server key in EXPO_PUBLIC_* variables or the mobile app.
PIKKU_OPENAI_API_KEY=
# Empty key: manual schedule features work; chat reports not_configured.
PORT=3001
# Optional only when using --lan with multiple network interfaces.
PIKKU_DEV_LAN_HOST=
# Hosted PostgreSQL URL; leave empty when using dev:local --postgres.
PIKKU_DATABASE_URL=
# Server scheduler only. User evening/morning settings are initially disabled.
PIKKU_SCHEDULER_ENABLED=false
# Google member login and per-user OAuth web client; server-side only.
PIKKU_GOOGLE_OAUTH_CLIENT_ID=
PIKKU_GOOGLE_OAUTH_CLIENT_SECRET=
# Google Cloud must register this exact HTTPS URL ending /v1/google/oauth/callback.
PIKKU_GOOGLE_OAUTH_REDIRECT_URI=
# Absolute server-only private directory for per-user OAuth connections.
PIKKU_GOOGLE_USER_CREDENTIAL_DIR=
# Exact browser origins separated by commas, e.g. http://localhost:8081.
PIKKU_WEB_ORIGINS=
# Absolute server-only directory for operator-provisioned per-user phone credentials.
PIKKU_PHONE_CREDENTIAL_DIR=

# Kakao place/current-route APIs: server-side REST key, never a mobile or JavaScript SDK key.
PIKKU_KAKAO_REST_API_KEY=

# Optional trusted absolute directory for local Gmail/Calendar credentials; empty keeps worktree defaults.
PIKKU_GOOGLE_CREDENTIAL_DIR=

# Legacy preview only: bind existing developer Google credentials to one user.
# Leave empty for normal per-user OAuth connections.
# Requires an explicit private PIKKU_GOOGLE_CREDENTIAL_DIR; never expose credentials to clients.
PIKKU_GOOGLE_CONNECTION_USER_ID=
# Seoul station arrivals, server-side only. Open-Meteo does not require a key.
SEOUL_SUBWAY_API_KEY=
# Default https; explicit http sends the provider key/station over an unencrypted upstream.
# No automatic downgrade. Any other value fails closed.
SEOUL_SUBWAY_TRANSPORT=https
